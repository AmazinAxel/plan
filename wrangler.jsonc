{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "plan",
	"compatibility_date": "2025-10-08",
	"main": "./worker.ts",
	// Minifies public/ into dist/ (see build.ts).
	"build": {
		"command": "bun run build",
		"watch_dir": "public"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// "/" is assembled by the worker (see servePage); the other two get immutable
		// caching there when requested with a content version.
		"run_worker_first": ["/", "/styles.css", "/app.js"]
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "PLAN_KV",
			"id": "a7482a28bc8047c6af8cf4ea9ea77d29",
			"remote": true
		}
	]
}